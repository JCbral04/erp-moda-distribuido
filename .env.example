# =============================================================
# .env.example — Plantilla de variables de entorno para Docker
#
# INSTRUCCIONES:
#   1. Copia este archivo como `.env` en la raíz del proyecto:
#        cp .env.example .env
#   2. Edita `.env` y establece valores reales para tu entorno local.
#   3. NUNCA commitees `.env` — está en .gitignore.
#
# Este archivo (.env.example) sí se versiona porque contiene
# solo placeholders, no credenciales reales.
# =============================================================

# ── PostgreSQL local (Docker) ──────────────────────────────────
POSTGRES_USER=erpuser
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=erp_moda
