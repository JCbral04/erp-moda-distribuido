# Variables de entorno — ERP Moda Distribuido
# Copiar este archivo a .env y ajustar los valores para cada entorno.

# Cadena de conexión a PostgreSQL
DB__DefaultConnection=Host=localhost;Database=erp_moda;Username=erpuser;Password=tu_password

# Configuración JWT
Jwt__Key=clave-secreta-de-almenos-32-caracteres-cambiar-en-produccion
Jwt__Issuer=erp-moda-distribuido
Jwt__Audience=erp-moda-distribuido-client
Jwt__ExpirationMinutes=120

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
