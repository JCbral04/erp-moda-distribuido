# =============================================================
# .env.example — Plantilla de variables de entorno para Docker
#
# INSTRUCCIONES:
#   1. Copia este archivo como `.env` en la raíz del proyecto:
#        cp .env.example .env
#   2. Edita `.env` y establece valores reales para tu entorno local.
#   3. NUNCA commitees `.env` — está en .gitignore.
#
# Este archivo (.env.example) sí se versiona porque contiene
# solo placeholders, no credenciales reales.
# =============================================================

# ── PostgreSQL local (Docker) ──────────────────────────────────
POSTGRES_USER=erpuser
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=erp_moda

# ── Lector de QR (Inventario) ───────────────────────────────────
# Redes CIDR o IPs permitidas para POST /api/productos/escaneo-qr en Production.
# Se pasa al backend como EscaneoQr__RedesPermitidas.
# VACÍO = nadie pasa (denegación por defecto). No use 0.0.0.0/0.
# Ejemplo (solo ilustrativo, ajústelo a su red):
# ESCANEO_QR_REDES_PERMITIDAS=172.18.0.0/16,192.168.1.25
ESCANEO_QR_REDES_PERMITIDAS=
