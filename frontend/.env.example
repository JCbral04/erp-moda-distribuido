# Configuración de variables de entorno para el Frontend de ERP Moda

# DESARROLLO LOCAL (npm run dev)
# No es necesario definir esta variable: el valor por defecto es `/api`.
# Vite redirige `/api` a http://localhost:5286 (backend ASP.NET Core) mediante
# el proxy declarado en vite.config.ts, con changeOrigin: true.
# VITE_API_URL=/api

# OTROS ENTORNOS (producción, staging o despliegue en otro servidor)
# URL absoluta del API cuando frontend y backend están en dominios distintos:
# VITE_API_URL=https://api.tudominio.com/api
# Ruta relativa cuando un proxy inverso (Nginx/Traefik) publica API y frontend
# bajo el mismo origen:
# VITE_API_URL=/api

# Nota: VITE_API_URL se lee en tiempo de compilación (build). Para producción
# debe definirse antes de ejecutar `npm run build`.
