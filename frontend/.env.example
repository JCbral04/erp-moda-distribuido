# Configuración de variables de entorno para el Frontend de ERP Moda

# URL base de la API backend
# Desarrollo local (.NET API por defecto en puerto 5286):
VITE_API_URL=http://localhost:5286/api

# Despliegue en producción o proxy inverso (ej. Nginx):
# VITE_API_URL=https://api.tudominio.com/api
# o si se utiliza proxy relativo en el mismo origen:
# VITE_API_URL=/api
